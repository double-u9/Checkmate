# ──────────────────────────────────────────────────────────────
# Aethelred — Environment Configuration
# Copy this file to .env and update values for your environment
# ──────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=change-me-in-production

# ─── Stockfish Engine ─────────────────────────────────────────
# Windows:  backend/stockfish/stockfish/stockfish-windows-x86-64-avx2.exe
# Linux:    /usr/games/stockfish (apt install stockfish)
# macOS:    /opt/homebrew/bin/stockfish (brew install stockfish)
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=20
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=256

# ─── Database ─────────────────────────────────────────────────
# Local dev (SQLite — zero config):
#   DATABASE_URL=sqlite+aiosqlite:///./aethelred.db
# Docker / Production (PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://aethelred:aethelred_secret@db:5432/aethelred
DATABASE_URL=sqlite+aiosqlite:///./aethelred.db

# PostgreSQL settings (only used with docker-compose)
POSTGRES_USER=aethelred
POSTGRES_PASSWORD=aethelred_secret
POSTGRES_DB=aethelred

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Computer Vision ──────────────────────────────────────────
CV_MODEL_PATH=ml/weights/board_detector.pt
PIECE_MODEL_PATH=ml/weights/piece_classifier.pth
CV_CONFIDENCE_THRESHOLD=0.5
